local badgeDragging, badgeDragStart, badgeStartPos, hasMoved = false, nil, nil, false

ToggleBadge.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        badgeDragging = true
        hasMoved = false
        badgeDragStart = input.Position
        badgeStartPos = ToggleBadge.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if badgeDragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - badgeDragStart
        if delta.Magnitude > 5 then hasMoved = true end
        
        local newPos = UDim2.new(badgeStartPos.X.Scale, badgeStartPos.X.Offset + delta.X, badgeStartPos.Y.Scale, badgeStartPos.Y.Offset + delta.Y)
        ToggleBadge.Position = ClampToScreen(newPos, ToggleBadge.Size)
    end
end)

ToggleBadge.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        badgeDragging = false
        if not hasMoved then ToggleUI() end
    end
end)

