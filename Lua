local function SafeLoadScript(url, btn)
    local success, result = false, nil
    
    local fetchMethods = {
        function() return game:HttpGet(url, true) end,
        function() return game:HttpGetAsync(url) end,
        function() 
            local req = (request or http_request or (http and http.request))
            if req then return req({Url = url, Method = "GET"}).Body end
        end
    }

    for _, method in ipairs(fetchMethods) do
        success, result = pcall(method)
        if success and result then break end
    end

    if success and result then
        task.spawn(function()
            local execFunc, loadErr = loadstring(result)
            if execFunc then
                local execSuccess, runErr = pcall(execFunc)
                if not execSuccess then warn("Crypto Ultimate Runtime Error: " .. tostring(runErr)) end
            else
                warn("Crypto Ultimate Syntax Error: " .. tostring(loadErr))
            end
        end)
        if btn then btn.Text = "INJECTED!" btn.TextColor3 = Color3.fromRGB(50, 255, 50) end
    else
        warn("Crypto Ultimate Error: Target network refused connection.")
        if btn then btn.Text = "NETWORK FAIL" btn.TextColor3 = Color3.fromRGB(255, 50, 50) end
    end
    
    task.wait(2)
    if btn then btn.Text = "Execute" btn.TextColor3 = Color3.fromRGB(255, 255, 255) end
end

