local function ClampToScreen(position, size)
    local screen = workspace.CurrentCamera
    local screenSize = screen and screen.ViewportSize or Vector2.new(1920, 1080)
    
    local x = math.clamp(position.X.Offset, 0, math.max(0, screenSize.X - size.X.Offset))
    local y = math.clamp(position.Y.Offset, 0, math.max(0, screenSize.Y - size.Y.Offset))
    return UDim2.new(position.X.Scale, x, position.Y.Scale, y)
end

