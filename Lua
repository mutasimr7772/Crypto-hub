    else
        getgenv().Crypto_ESP_Active = true
        titleLabel.Text = "Player ESP [ON]"
        titleLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        
        task.spawn(function()
            while getgenv().Crypto_ESP_Active do
                for _, player in pairs(Players:GetPlayers()) do
