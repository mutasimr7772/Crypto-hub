-- Render Script List Function (Supports collapsing and instant search updating)
local function RenderList()
    -- Safely clear old UI cards
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
    
    local currentLayoutOrder = 1
    local query = string.lower(SearchBar.Text)
    
    for _, cat in ipairs(ScriptDatabase) do
        local isOpen = CategoryState[cat.Id]
        
        -- Generate Header
        local Header = Instance.new("TextButton")
        Header.Size = UDim2.new(1, -5, 0, 30)
        Header.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        Header.BorderSizePixel = 0
        local chevron = isOpen and "▼ " or "▶ "
        Header.Text = "   " .. chevron .. cat.Title
        Header.TextColor3 = cat.Color
        Header.Font = Enum.Font.GothamBlack
        Header.TextSize = 12
        Header.TextXAlignment = Enum.TextXAlignment.Left
        Header.LayoutOrder = currentLayoutOrder
        Header.Parent = ScrollFrame
        currentLayoutOrder = currentLayoutOrder + 1
        
        local HeadCorner = Instance.new("UICorner")
        HeadCorner.CornerRadius = UDim.new(0, 6)
        HeadCorner.Parent = Header
        
        -- Toggle category collapse when header clicked
        Header.Activated:Connect(function()
            CategoryState[cat.Id] = not CategoryState[cat.Id]
            RenderList()
        end)
        
        -- If open, load individual script cards
        if isOpen then
            for _, item in ipairs(cat.Scripts) do
                -- Search Match Filter
                if query == "" or string.find(string.lower(item.Name), query) or string.find(string.lower(item.Tags), query) then
                    local Card = Instance.new("Frame")
                    Card.Size = UDim2.new(1, -5, 0, 55)
                    Card.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
                    Card.BorderSizePixel = 0
                    Card.LayoutOrder = currentLayoutOrder
                    Card.Parent = ScrollFrame
                    currentLayoutOrder = currentLayoutOrder + 1
                    
                    local CardCorner = Instance.new("UICorner")
                    CardCorner.CornerRadius = UDim.new(0, 6)
                    CardCorner.Parent = Card
                    
                    -- Script Label
                    local NameLbl = Instance.new("TextLabel")
                    NameLbl.Size = UDim2.new(0.6, 0, 0, 20)
                    NameLbl.Position = UDim2.new(0, 12, 0, 10)
                    NameLbl.BackgroundTransparency = 1
                    NameLbl.Text = item.Name
                    NameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    NameLbl.Font = Enum.Font.GothamBold
                    NameLbl.TextSize = 13
                    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
                    NameLbl.Parent = Card
                    
                    -- Meta Sublabel
                    local SubLbl = Instance.new("TextLabel")
                    SubLbl.Size = UDim2.new(0.6, 0, 0, 15)
                    SubLbl.Position = UDim2.new(0, 12, 0, 28)
                    SubLbl.BackgroundTransparency = 1
                    SubLbl.Text = item.Tags
                    SubLbl.TextColor3 = Color3.fromRGB(140, 140, 145)
                    SubLbl.Font = Enum.Font.GothamMedium
                    SubLbl.TextSize = 10
                    SubLbl.TextXAlignment = Enum.TextXAlignment.Left
                    SubLbl.Parent = Card
                    
                    -- Action Button (Execute)
                    local ActionBtn = Instance.new("TextButton")
                    ActionBtn.Size = UDim2.new(0, 90, 0, 32)
                    ActionBtn.Position = UDim2.new(1, -100, 0.5, -16)
                    
                    if item.Status == "Not Working" then
                        ActionBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
                        ActionBtn.Text = "Offline"
                        ActionBtn.TextColor3 = Color3.fromRGB(110, 110, 120)
                        ActionBtn.AutoButtonColor = false
                    else
                        ActionBtn.BackgroundColor3 = Color3.fromRGB(255, 40, 60)
                        ActionBtn.Text = "Execute"
                        ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        ActionBtn.Font = Enum.Font.GothamBold
                        ActionBtn.TextSize = 12
                        
                        ActionBtn.Activated:Connect(function()
                            ActionBtn.Text = "Loading..."
                            SafeLoadScript(item.Url, ActionBtn)
                        end)
                    end
                    
                    ActionBtn.Parent = Card
                    local ActCorner = Instance.new("UICorner")
                    ActCorner.CornerRadius = UDim.new(0, 6)
                    ActCorner.Parent = ActionBtn
                end
            end
        end
    end
end

