local function ClampToScreen(position, size)
    local screenSize = workspace.CurrentCamera.ViewportSize
    local x = math.clamp(position.X.Offset, 0, screenSize.X - size.X.Offset)
    local y = math.clamp(position.Y.Offset, 0, screenSize.Y - size.Y.Offset)
    return UDim2.new(position.X.Scale, x, position.Y.Scale, y)
end

