-- ==========================================
local function SafeLoadScript(url, btn)
    local success, result = false, nil
    
    success, result = pcall(function() return game:HttpGet(url) end)
    
    if not success or not result then
        local req = (request or http_request or (http and http.request))
        if req then
            success, result = pcall(function() return req({Url = url, Method = "GET"}).Body end)
        end
    end

    if success and result then
        local execSuccess, execError = pcall(function() loadstring(result)() end)
        if not execSuccess then
            warn("CryptoHub Error: " .. tostring(execError))
            if btn then btn.Text = "Exec Error" end
        else
            if btn then btn.Text = "Executed!" end
        end
    else
        warn("CryptoHub Error: All fetch methods failed.")
        if btn then btn.Text = "Network Error" end
    end
    
    task.wait(2)
    if btn then btn.Text = "Execute" end
end

