local function OpenMenu()
    if isAnimating or MainFrame.Visible then return end
    isAnimating = true
    MainFrame.Visible = true
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Size = UDim2.new(0, 600, 0, 460) })
    tween:Play()
    tween.Completed:Wait()
    isAnimating = false
end

local function CloseMenu()
    if isAnimating or not MainFrame.Visible then return end
    isAnimating = true
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
    tween:Play()
    tween.Completed:Wait()
    MainFrame.Visible = false
    isAnimating = false
end

CloseBtn.Activated:Connect(CloseMenu)

